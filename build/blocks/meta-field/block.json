{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "theatrum/meta-field",
  "title": "Meta Field",
  "category": "metablock",
  "description": "Display a value from post metadata by entering a key",
  "icon": "admin-generic",
  "supports": {
    "html": false,
    "align": true,
    "reusable": true,
    "anchor": true,
    "className": true,
    "customClassName": true,
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true
    },
    "color": {
      "text": true,
      "background": true,
      "gradient": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "opacity": true,
    "filters": {
      "duotone": true
    }
  },
  "attributes": {
    "keyInput": {
      "type": "string",
      "default": ""
    },
    "tagName": {
      "type": "string",
      "default": "span"
    },
    "href": {
      "type": "string",
      "default": ""
    },
    "prepend": {
      "type": "string",
      "default": ""
    },
    "append": {
      "type": "string",
      "default": ""
    }
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "example": {},
  "keywords": [
    "meta",
    "custom field",
    "acf",
    "field"
  ],
  "textdomain": "theatrum-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}