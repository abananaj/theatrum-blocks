{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chance/meta-file",
  "title": "Meta File Link",
  "category": "metablock",
  "description": "Display a link to a file from a post meta or ACF file field by entering a key",
  "icon": "media-document",
  "supports": {
    "html": false,
    "anchor": true,
    "className": true,
    "customClassName": true,
    "color": {
      "link": true,
      "text": true,
      "background": false
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "attributes": {
    "keyInput": {
      "type": "string",
      "default": ""
    },
    "linkText": {
      "type": "string",
      "default": "Download File"
    },
    "fallbackText": {
      "type": "string",
      "default": ""
    },
    "openInNewTab": {
      "type": "boolean",
      "default": true
    },
    "showIcon": {
      "type": "boolean",
      "default": true
    }
  },
  "example": {},
  "keywords": [
    "file",
    "download",
    "attachment",
    "meta"
  ],
  "textdomain": "theatrum-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}