{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "theatrum/popup",
  "title": "popup",
  "category": "theatrum",
  "icon": "visibility",
  "description": "A dialog/popup block. Opened by any core/button linked to it via its HTML Anchor.",
  "supports": {
    "html": false,
    "align": true,
    "anchor": true,
    "className": true,
    "customClassName": true,
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true
    },
    "color": {
      "text": true,
      "background": true,
      "gradient": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "filter": {
      "duotone": true
    }
  },
  "attributes": {
    "dialogLabel": {
      "type": "string",
      "default": ""
    },
    "autoOpenDelay": {
      "type": "number",
      "default": 0
    }
  },
  "example": {},
  "keywords": [
    "modal",
    "dialog",
    "overlay",
    "lightbox",
    "trigger",
    "anchor"
  ],
  "textdomain": "theatrum-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}