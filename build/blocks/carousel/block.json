{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "theatrum/carousel",
  "title": "Carousel",
  "category": "theatrum",
  "icon": "images-alt2",
  "description": "A responsive carousel display for cards with images, titles, and subtitles",
  "textdomain": "theatrum-blocks",
  "supports": {
    "html": false,
    "align": true,
    "anchor": true,
    "className": true,
    "customClassName": true,
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true
    },
    "color": {
      "text": true,
      "background": true,
      "gradient": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "filter": {
      "duotone": true
    }
  },
  "attributes": {
    "cardWidth": {
      "type": "string",
      "default": ""
    },
    "cardWidthUnit": {
      "type": "string",
      "default": "px",
      "enum": [
        "px",
        "%",
        "em",
        "rem"
      ]
    },
    "gap": {
      "type": "string",
      "default": ""
    },
    "gapUnit": {
      "type": "string",
      "default": "px",
      "enum": [
        "px",
        "%",
        "em",
        "rem"
      ]
    },
    "arrowPosition": {
      "type": "string",
      "default": "outside",
      "enum": [
        "outside",
        "inside",
        "hidden"
      ]
    },
    "showScrollbar": {
      "type": "boolean",
      "default": false
    },
    "arrowBackground": {
      "type": "boolean",
      "default": true
    },
    "arrowColor": {
      "type": "string",
      "default": ""
    },
    "arrowBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "arrowSize": {
      "type": "string",
      "default": ""
    },
    "arrowSizeUnit": {
      "type": "string",
      "default": "px",
      "enum": [
        "px",
        "%",
        "em",
        "rem"
      ]
    }
  },
  "allowedBlocks": [
    "theatrum/carousel-item"
  ],
  "example": {},
  "keywords": [
    "carousel",
    "slider",
    "cards",
    "gallery"
  ],
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}