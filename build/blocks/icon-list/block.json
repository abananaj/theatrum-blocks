{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chance/icon-list",
  "title": "Icon List",
  "category": "theatrum",
  "description": "A list block with optional icons for each item. Supports ordered and unordered lists with customizable icon styling.",
  "icon": "list-view",
  "example": {},
  "keywords": [
    "list",
    "icon",
    "item"
  ],
  "supports": {
    "html": false,
    "align": true,
    "reusable": true,
    "anchor": true,
    "className": true,
    "customClassName": true,
    "color": {
      "text": true,
      "background": true,
      "gradient": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "opacity": true
  },
  "attributes": {
    "listType": {
      "type": "string",
      "default": "ul",
      "enum": [
        "ul",
        "ol"
      ]
    },
    "items": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the list item"
          },
          "text": {
            "type": "string",
            "description": "Text content of the list item"
          },
          "iconId": {
            "type": "number",
            "description": "Media library attachment ID"
          },
          "iconUrl": {
            "type": "string",
            "description": "URL of the icon image"
          },
          "iconAlt": {
            "type": "string",
            "description": "Alt text for the icon"
          }
        }
      }
    },
    "iconSize": {
      "type": "string",
      "default": "24"
    },
    "iconSizeUnit": {
      "type": "string",
      "default": "px",
      "enum": [
        "px",
        "em",
        "rem",
        "%"
      ]
    },
    "iconPosition": {
      "type": "string",
      "default": "left",
      "enum": [
        "left",
        "top",
        "right",
        "bottom"
      ]
    },
    "iconSpacing": {
      "type": "string",
      "default": "8"
    },
    "iconColor": {
      "type": "string",
      "default": ""
    },
    "hoverOnly": {
      "type": "boolean",
      "default": false
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}