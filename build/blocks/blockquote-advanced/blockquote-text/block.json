{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "theatrum/blockquote-text",
  "title": "Text",
  "category": "theatrum",
  "icon": "editor-quote",
  "description": "The quoted text, with an optional source URL.",
  "textdomain": "theatrum-blocks",
  "parent": [
    "theatrum/blockquote-advanced"
  ],
  "attributes": {
    "citeUrl": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "anchor": true,
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true
    },
    "color": {
      "text": true
    }
  },
  "editorScript": "file:./index.js"
}