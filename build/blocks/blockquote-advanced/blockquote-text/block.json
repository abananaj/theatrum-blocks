{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chance/blockquote-text",
  "title": "Text",
  "category": "theatrum",
  "icon": "editor-quote",
  "description": "The quoted text, with an optional source URL.",
  "textdomain": "theatrum-blocks",
  "parent": [
    "chance/blockquote-advanced"
  ],
  "attributes": {
    "quoteText": {
      "type": "rich-text",
      "source": "rich-text",
      "selector": "blockquote",
      "multiline": "p",
      "role": "content"
    },
    "citeUrl": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "anchor": true,
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "color": {
      "text": true
    }
  },
  "editorScript": "file:./index.js"
}