{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chance/season-producer",
  "title": "Season Producer",
  "category": "metablock",
  "description": "Display season producer titles from the current post's season taxonomy term.",
  "icon": "awards",
  "supports": {
    "html": false,
    "align": true,
    "anchor": true,
    "className": true,
    "customClassName": true,
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true
    },
    "color": {
      "text": true,
      "background": true,
      "gradient": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "opacity": true
  },
  "attributes": {
    "metaKey": {
      "type": "string",
      "default": "season_producers"
    },
    "tagName": {
      "type": "string",
      "default": "ul"
    },
    "headingText": {
      "type": "string",
      "default": ""
    },
    "headingLevel": {
      "type": "string",
      "default": "h2"
    }
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "example": {},
  "keywords": [
    "producer",
    "season",
    "staff",
    "theater"
  ],
  "textdomain": "theatrum-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}