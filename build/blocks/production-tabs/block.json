{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "theatrum/production-tabs",
  "title": "Production Tabs",
  "category": "production",
  "icon": "index-card",
  "description": "Horizontal tabs that collapse into a vertical accordion on mobile. Add a tab for each section and give it a heading.",
  "textdomain": "theatrum-blocks",
  "attributes": {
    "equalWidthTabs": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "text": true,
      "background": true,
      "gradients": true
    },
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textTransform": true
    }
  },
  "allowedBlocks": [
    "theatrum/tab"
  ],
  "example": {
    "innerBlocks": [
      {
        "name": "theatrum/tab",
        "innerBlocks": [
          {
            "name": "theatrum/tab-heading",
            "innerBlocks": [
              {
                "name": "core/heading",
                "attributes": {
                  "level": 3,
                  "content": "Synopsis"
                }
              }
            ]
          },
          {
            "name": "theatrum/tab-content",
            "innerBlocks": [
              {
                "name": "core/paragraph",
                "attributes": {
                  "content": "What the show is about."
                }
              }
            ]
          }
        ]
      },
      {
        "name": "theatrum/tab",
        "innerBlocks": [
          {
            "name": "theatrum/tab-heading",
            "innerBlocks": [
              {
                "name": "core/heading",
                "attributes": {
                  "level": 3,
                  "content": "Cast"
                }
              }
            ]
          },
          {
            "name": "theatrum/tab-content",
            "innerBlocks": [
              {
                "name": "core/paragraph",
                "attributes": {
                  "content": "Who is in it."
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "keywords": [
    "tabs",
    "accordion",
    "tabbed",
    "sections"
  ],
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}