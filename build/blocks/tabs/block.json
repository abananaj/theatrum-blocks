{
  "apiVersion": 3,
  "name": "theatrum/tabs",
  "title": "Tabs",
  "category": "theatrum",
  "icon": "list-view",
  "description": "A tabbed content container with accessible keyboard navigation",
  "supports": {
    "html": false,
    "align": true,
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "color": {
      "text": true,
      "background": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "orientation": {
      "type": "string",
      "default": "horizontal",
      "enum": [
        "horizontal",
        "vertical"
      ]
    }
  },
  "usesInnerBlocks": true,
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.scss",
  "style": "file:./style.scss",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}