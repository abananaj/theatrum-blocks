{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chance/performance-repeater",
	"title": "Performance Repeater",
	"category": "chance",
	"description": "Display ACF repeater rows with a date subfield and a label subfield",
	"icon": "calendar-alt",
	"supports": {
		"html": false,
		"align": true,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"color": {
			"text": true,
			"background": true,
			"gradient": true
		},
		"typography": {
			"fontSize": true,
			"fontFamily": true,
			"fontWeight": true,
			"fontStyle": true,
			"lineHeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true,
			"textColumns": false
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"opacity": true
	},
	"usesContext": ["postId", "postType"],
	"attributes": {
		"repeaterKey": {
			"type": "string",
			"default": ""
		},
		"dateSubfield": {
			"type": "string",
			"default": ""
		},
		"labelSubfield": {
			"type": "string",
			"default": ""
		},
		"dateFormat": {
			"type": "string",
			"default": "l, F j"
		},
		"customFormat": {
			"type": "string",
			"default": ""
		},
		"tagName": {
			"type": "string",
			"default": "ul"
		},
		"headingText": {
			"type": "string",
			"default": ""
		},
		"headingLevel": {
			"type": "string",
			"default": "h2"
		}
	},
	"textdomain": "performance-repeater",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
