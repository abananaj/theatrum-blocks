{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"title": "Table Row",
	"name": "theatrum/table-row",
	"textdomain": "theatrum-blocks",
	"category": "text",
	"keywords": ["table"],
	"attributes": {
		"char": {
			"type": "string",
			"default": ""
		},
		"charoff": {
			"type": "string",
			"default": ""
		}
	},
	"parent": [
		"theatrum/table-header",
		"theatrum/table-body",
		"theatrum/table-footer"
	],
	"ancestor": ["theatrum/table-advanced"],
	"allowedBlocks": ["theatrum/table-heading-cell", "theatrum/table-cell"],
	"supports": {
		"anchor": true,
		"align": ["wide", "full", "left", "center", "right"],
		"alignWide": true,
		"allowedBlocks": true,
		"className": true,
		"shadow": true,
		"color": {
			"background": true,
			"text": true,
			"enableContrastChecker": true,
