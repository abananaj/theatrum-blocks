{
	"apiVersion": 3,
	"title": "Table Title",
	"name": "theatrum/table-caption",
	"category": "text",
	"icon": "editor-table",
	"keywords": ["table"],
	"attributes": {
		"headingLevel": {
			"type": "number",
			"default": 2
		}
	},
	"parent": ["theatrum/table-advanced"],
	"allowedBlocks": ["core/paragraph", "core/heading"],
	"providesContext": {
		"theatrum/headingLevel": "attributes.headingLevel"
	},
	"supports": {
		"anchor": true,
		"align": ["wide", "full", "left", "center", "right"],
		"alignWide": true,
		"className": true,
		"color": {
			"background": true,
			"text": true,
			"enableContrastChecker": true,
			"gradients": false,
			"link": true,
			"heading": false,
			"button": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"dimensions": {
			"aspectRatio": true,
			"height": true,
			"minHeight": true,
			"minWidth": true,
			"width": true
		},
		"typography": {
			"fitText": true,
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"textIndent": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"__experimentalSkipSerialization": true,
			"color": true,
			"style": true,
			"width": true
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"blockHooks": {
		"core/heading": "firstChild"
	},
	"selectors": {
		"root": ".tm-table-advanced .tm-table-adv-title"
	},
	"editorScript": "file:./index.js"
}
