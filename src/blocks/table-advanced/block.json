{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "theatrum/table-advanced",
	"title": "Advanced Table",
	"category": "text",
	"description": "Version of core table block that allows nesting of table elements as nested blocks.",
	"textdomain": "table-advanced",
	"icon": "editor-table",
	"attributes": {
		"hasThead": {
			"type": "boolean",
			"default": true
		},
		"hasTFoot": {
			"type": "boolean",
			"default": false
		},
		"tableTitle": {
			"type": "rich-text",
			"source": "rich-text",
			"selector": "table > caption",
			"role": "content"
		}
	},
	"allowedBlocks": [
		"theatrum/table-caption", 
		"theatrum/table-header", 
		"theatrum/table-body", 
		"theatrum/table-footer",
		"theatrum/table-row",
		"theatrum/table-header-cell",
		"theatrum/table-cell"
	],
	"supports": {
		"anchor": true,
		"align": ["wide", "full", "left", "center", "right"],
		"alignWide": true,
		"allowedBlocks": true,
		"className": true,
		"color": {
			"background": true,
			"text": true,
			"enableContrastChecker": true,
			"gradients": false,
			"link": true,
			"heading": false,
			"button": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"margin": false,
				"padding": false
			}
		},
		"dimensions": {
			"aspectRatio": true,
			"height": true,
			"minHeight": true,
			"minWidth": true,
			"width": true
		},
		"typography": {
			"fitText": true,
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"textIndent": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"__experimentalSkipSerialization": true,
			"color": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"style": true,
				"width": true
			}
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"blockHooks": {
		"theatrum/table-caption": "firstChild",
		"theatrum/table-body": "firstChild"
	},
	"selectors": {
		"root": ".tm-table-advanced"
	},
	"styles": [
		{
			"name": "regular",
			"label": "Default",
			"isDefault": true
		},
		{ "name": "stripes", "label": "Stripes" }
	],
	"example": {},
	"keywords": ["table", "data", "rows", "columns"],
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
