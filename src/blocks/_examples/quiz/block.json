{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "block-development-examples/quiz",
	"version": "1.0.0",
	"title": "Quiz",
	"category": "widgets",
	"keywords": ["example"],
	"icon": "smiley",
	"description": "Make a quiz",
	"supports": {
		"interactivity": true
	},
	"parent": ["block-development-examples/quiz-progress"],
	"attributes": {
		"question": {
			"type": "string"
		},
		"typeOfQuiz": {
			"type": "string",
			"enum": ["boolean", "input"],
			"default": "boolean"
		},
		"answer": {
			"type": ["string", "boolean"],
			"default": true
		}
	},
	"textdomain": "block-development-examples",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
