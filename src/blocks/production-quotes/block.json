{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chance/production-quotes",
	"title": "Production Quotes",
	"category": "production",
	"description": "Display quotes from the production_quotes ACF repeater field",
	"icon": "format-quote",
	"supports": {
		"html": false,
		"align": true,
		"reusable": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"typography": {
			"fontSize": true,
			"fontFamily": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true
		},
		"color": {
			"text": true,
			"background": true,
			"gradient": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"filter": {
			"duotone": true
		}
	},
	"attributes": {},
	"usesContext": ["postId", "postType"],
	"example": {},
	"keywords": ["quotes", "reviews", "press", "testimonials"],
	"textdomain": "theatrum-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
