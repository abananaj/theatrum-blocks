{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chance/term-meta",
	"title": "Term Meta",
	"category": "chance",
	"icon": "tag",
	"description": "Display metadata for a selected taxonomy term",
	"supports": {
		"html": false,
		"align": true,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"color": {
			"text": true,
			"background": true,
			"gradient": true
		},
		"typography": {
			"fontSize": true,
			"fontFamily": true,
			"fontWeight": true,
			"fontStyle": true,
			"lineHeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true,
			"textColumns": false
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"opacity": true,
		"filters": {
			"duotone": true
		}
	},
	"attributes": {
		"termId": {
			"type": "number",
			"default": 0
		},
		"metaKey": {
			"type": "string",
			"default": ""
		},
		"tagName": {
			"type": "string",
			"default": "p"
		},
		"prepend": {
			"type": "string",
			"default": ""
		},
		"append": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "term-meta",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
