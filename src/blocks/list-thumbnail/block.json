{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chance/list-thumbnail",
	"title": "Thumbnail List",
	"category": "theatrum",
	"icon": "format-gallery",
	"description": "An interactive list with thumbnail images that display when hovering over items. Each item is a nested block with a title, description, and thumbnail image.",
	"textdomain": "theatrum-blocks",
	"allowedBlocks": ["chance/list-item-thumbnail"],
	"providesContext": {
		"chance/imageSizeSlug": "imageSizeSlug"
	},
	"supports": {
		"html": false,
		"align": true,
		"reusable": true,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"typography": {
			"fontSize": true,
			"fontFamily": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true
		},
		"color": {
			"text": true,
			"background": true,
			"gradient": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"opacity": true,
		"filters": {
			"duotone": true
		}
	},
	"attributes": {
		"thumbnailWidth": {
			"type": "string",
			"default": "400"
		},
		"thumbnailWidthUnit": {
			"type": "string",
			"default": "px",
			"enum": ["px", "%", "em", "rem"]
		},
		"thumbnailHeight": {
			"type": "string",
			"default": "300"
		},
		"thumbnailHeightUnit": {
			"type": "string",
			"default": "px",
			"enum": ["px", "%", "em", "rem"]
		},
		"itemHeight": {
			"type": "string",
			"default": "80"
		},
		"itemHeightUnit": {
			"type": "string",
			"default": "px"
		},
		"thumbnailPosition": {
			"type": "string",
			"default": "right",
			"enum": ["left", "right"]
		},
		"animationSpeed": {
			"type": "string",
			"default": "0.3",
			"enum": ["0.2", "0.3", "0.5", "1"]
		},
		"imageSizeSlug": {
			"type": "string",
			"default": "full",
			"description": "WP registered image size used to resolve each item's thumbnail URL"
		},
		"thumbnailAspectRatio": {
			"type": "string",
			"default": "auto",
			"enum": ["auto", "1", "4/3", "3/4", "16/9", "9/16"]
		},
		"thumbnailObjectFit": {
			"type": "string",
			"default": "cover",
			"enum": ["cover", "contain", "fill"]
		}
	},
	"example": {},
	"keywords": ["thumbnails", "gallery", "images", "list"],
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
