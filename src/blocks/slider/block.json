{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "theatrum/slider",
	"title": "Slider",
	"category": "theatrum",
	"icon": "images-alt2",
	"description": "A fading slideshow with prev/next arrows and dot navigation. Each slide is a Slider Item that can hold any blocks.",
	"textdomain": "theatrum-blocks",
	"supports": {
		"html": false,
		"align": true,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"color": {
			"text": true,
			"background": true,
			"gradient": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"attributes": {
		"autoplay": {
			"type": "boolean",
			"default": false
		},
		"autoplaySpeed": {
			"type": "number",
			"default": 5000,
			"minimum": 100,
			"maximum": 10000
		},
		"arrowPosition": {
			"type": "string",
			"default": "inside",
			"enum": ["outside", "inside", "hidden"]
		},
		"arrowBackground": {
			"type": "boolean",
			"default": true
		},
		"arrowColor": {
			"type": "string",
			"default": ""
		},
		"arrowBackgroundColor": {
			"type": "string",
			"default": ""
		},
		"arrowSize": {
			"type": "string",
			"default": ""
		},
		"arrowSizeUnit": {
			"type": "string",
			"default": "px",
			"enum": ["px", "%", "em", "rem"]
		}
	},
	"allowedBlocks": ["theatrum/slider-item"],
	"example": {},
	"keywords": ["slider", "slideshow", "carousel", "gallery"],
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
