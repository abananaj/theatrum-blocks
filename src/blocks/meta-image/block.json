{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chance/meta-image",
	"title": "Meta Image",
	"category": "metablock",
	"description": "Display an image from a post meta or ACF image field by entering a key",
	"icon": "format-image",
	"supports": {
		"html": false,
		"align": ["left", "center", "right", "wide", "full"],
		"anchor": true,
		"className": true,
		"customClassName": true,
		"color": {
			"duotone": true
		},
		"filter": {
			"duotone": true
		},
		"shadow": true,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"usesContext": ["postId", "postType"],
	"attributes": {
		"keyInput": {
			"type": "string",
			"default": ""
		},
		"imageSize": {
			"type": "string",
			"default": "full"
		},
		"linkTo": {
			"type": "string",
			"default": "none"
		},
		"customLink": {
			"type": "string",
			"default": ""
		},
		"openInNewTab": {
			"type": "boolean",
			"default": false
		},
		"showCaption": {
			"type": "boolean",
			"default": false
		},
		"aspectRatio": {
			"type": "string",
			"default": "auto",
			"enum": ["auto", "1", "4/3", "3/4", "16/9", "9/16"]
		}
	},
	"example": {},
	"keywords": ["image", "photo", "meta", "custom field", "acf"],
	"textdomain": "theatrum-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
