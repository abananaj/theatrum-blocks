{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "theatrum/card-expanding",
	"title": "Expanding Card",
	"category": "theatrum",
	"icon": "excerpt-view",
	"description": "A card that expands on click to reveal a description — click-triggered, not hover-only, with real button semantics.",
	"keywords": ["card", "expand", "reveal", "click"],
	"textdomain": "theatrum-blocks",
	"attributes": {
		"mediaId": { "type": "number", "default": 0 },
		"mediaUrl": { "type": "string", "default": "" },
		"mediaAlt": { "type": "string", "default": "" },
		"title": {
			"type": "rich-text",
			"source": "rich-text",
			"selector": ".wp-block-theatrum-card-expanding__title",
			"default": ""
		},
		"description": {
			"type": "rich-text",
			"source": "rich-text",
			"selector": ".wp-block-theatrum-card-expanding__description",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": false,
				"text": false
			}
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
