{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "theatrum/card-expanding",
	"title": "Expanding Card",
	"category": "theatrum",
	"icon": "excerpt-view",
	"description": "A card that expands on click to reveal everything below its heading — click-triggered, not hover-only, with real button semantics. Heading and body are nested blocks; the image is chosen and sized in the sidebar.",
	"keywords": [
		"card",
		"expand",
		"reveal",
		"click"
	],
	"textdomain": "theatrum-blocks",
	"usesContext": [
		"postId",
		"postType"
	],
	"attributes": {
		"useFeaturedImage": {
			"type": "boolean",
			"default": false
		},
		"mediaId": {
			"type": "number",
			"default": 0
		},
		"mediaUrl": {
			"type": "string",
			"default": ""
		},
		"mediaAlt": {
			"type": "string",
			"default": ""
		},
		"imageSizeSlug": {
			"type": "string",
			"default": "full"
		},
		"imageWidth": {
			"type": "string",
			"default": "100"
		},
		"imageWidthUnit": {
			"type": "string",
			"default": "%"
		},
		"imageHeight": {
			"type": "string",
			"default": ""
		},
		"imageHeightUnit": {
			"type": "string",
			"default": "px"
		},
		"imageAspectRatio": {
			"type": "string",
			"default": "4/3"
		},
		"imageObjectFit": {
			"type": "string",
			"default": "cover"
		},
		"imageFocalPoint": {
			"type": "object"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": false,
				"text": false
			}
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
