{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chance/heading-toggle",
	"title": "Heading Toggle",
	"category": "text",
	"icon": "heading",
	"description": "Heading with a toggle to show/hide nested content",
	"keywords": ["heading", "toggle", "collapsible", "accordion"],
	"supports": {
		"html": false,
		"align": true,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true,
		"color": {
			"text": true,
			"background": true,
			"gradient": true
		},
		"typography": {
			"textAlign": true,
			"fontSize": true,
			"fontFamily": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"attributes": {
		"content": {
			"type": "string",
			"source": "html",
			"selector": "summary",
			"default": ""
		},
		"level": {
			"type": "number",
			"default": 2
		},
		"isOpen": {
			"type": "boolean",
			"default": false
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"style": "file:./style.scss",
	"editorStyle": "file:./editor.scss"
}
