{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chance/subtitle-title",
	"title": "Subtitle + Title",
	"category": "text",
	"icon": "heading",
	"description": "Display the post title with an optional subtitle heading before or after it",
	"keywords": ["title", "subtitle", "heading", "post title"],
	"supports": {
		"html": false,
		"align": true,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": true,
		"color": {
			"text": true,
			"background": true,
			"gradient": true
		},
		"typography": {
			"fontSize": true,
			"fontFamily": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"usesContext": ["postId", "postType"],
	"attributes": {
		"level": {
			"type": "number",
			"default": 1
		},
		"subtitle": {
			"type": "string",
			"default": ""
		},
		"subtitlePosition": {
			"type": "string",
			"default": "before"
		},
		"isLink": {
			"type": "boolean",
			"default": false
		},
		"linkTarget": {
			"type": "string",
			"default": "_self"
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.scss",
	"editorStyle": "file:./editor.scss"
}
