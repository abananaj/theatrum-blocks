{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chance/popup",
  "title": "Popup",
  "category": "common",
  "icon": "visibility",
  "description": "A simple popup block with a button to reveal hidden content",
  "textdomain": "chance-ollie",
  "supports": {
    "html": false,
    "align": true,
    "anchor": true,
    "className": true,
    "customClassName": true,
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true
    },
    "color": {
      "text": true,
      "background": true,
      "gradient": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "opacity": true,
    "filters": {
      "duotone": true
    }
  },
  "attributes": {
    "buttonText": {
      "type": "string",
      "default": "Show More"
    },
    "isOpen": {
      "type": "boolean",
      "default": false
    }
  },
  "usesInnerBlocks": true,
  "viewScript": "file:./frontend.js"
}
