{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chance/styled-text",
	"title": "Styled Text",
	"category": "text",
	"description": "Flexible text block with selectable HTML tag and individually styled inline spans. Supports typography and color options per span.",
	"icon": "editor-textcolor",
	"supports": {
		"html": false,
		"align": true,
		"reusable": true,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"typography": {
			"fontSize": true,
			"fontFamily": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"textAlign": true
		},
		"color": {
			"text": true,
			"background": true,
			"gradient": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"opacity": true,
		"filters": {
			"duotone": true
		},
		"interactivity": true
	},
	"attributes": {
		"content": {
			"type": "string",
			"source": "html",
			"selector": "[data-styled-text]",
			"default": ""
		},
		"tagName": {
			"type": "string",
			"default": "p",
			"enum": ["h1", "h2", "h3", "h4", "h5", "h6", "p"]
		},
		"styledSpans": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"description": "Unique identifier for the span"
					},
					"text": {
						"type": "string",
						"description": "Text content of the span"
					},
					"fontSize": {
						"type": "string"
					},
					"fontFamily": {
						"type": "string"
					},
					"fontStyle": {
						"type": "string"
					},
					"fontWeight": {
						"type": "string"
					},
					"letterSpacing": {
						"type": "string"
					},
					"lineHeight": {
						"type": "string"
					},
					"textDecoration": {
						"type": "string"
					},
					"textTransform": {
						"type": "string"
					},
					"color": {
						"type": "string"
					},
					"backgroundColor": {
						"type": "string"
					}
				}
			}
		}
	},
	"styles": [],
	"textdomain": "styled-text",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
