{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chance/meta-gallery",
	"title": "Meta Gallery",
	"category": "media",
	"description": "Display a gallery of images from a post meta or ACF gallery field by entering a key",
	"icon": "format-gallery",
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"anchor": true,
		"className": true,
		"customClassName": true,
		"color": {
			"duotone": true
		},
		"filter": {
			"duotone": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		}
	},
	"usesContext": ["postId", "postType"],
	"attributes": {
		"keyInput": {
			"type": "string",
			"default": ""
		},
		"imageSize": {
			"type": "string",
			"default": "large"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"linkTo": {
			"type": "string",
			"default": "none"
		},
		"imageCrop": {
			"type": "boolean",
			"default": true
		},
		"showCaption": {
			"type": "boolean",
			"default": false
		},
		"fallbackText": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "meta-gallery",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
