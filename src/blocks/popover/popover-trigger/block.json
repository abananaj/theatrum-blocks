	"textdomain": "theatrum-blocks",
	"parent": ["chance/popover"],
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"spacing": {
			"padding": true,
			"blockGap": true
		},
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"fontFamily": true,
			"fontStyle": true,
			"fontWeight": true,
			"lineHeight": true
		}
	},
	"editorScript": "file:./index.js"
}
