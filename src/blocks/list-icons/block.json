{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "theatrum/list-icons",
	"textdomain": "theatrum-blocks",
	"title": "Icon List",
	"category": "theatrum",
	"description": "An unordered list block with optional icons for each item and customizable icon styling.",
	"icon": "list-view",
	"example": {},
	"keywords": ["list", "icon", "item"],
	"allowedBlocks": ["theatrum/list-item-icon"],
	"providesContext": {
		"theatrum/iconSize": "iconSize",
		"theatrum/iconSizeUnit": "iconSizeUnit",
		"theatrum/iconPosition": "iconPosition",
		"theatrum/iconSpacing": "iconSpacing",
		"theatrum/iconColor": "iconColor",
		"theatrum/hoverOnly": "hoverOnly"
	},
	"supports": {
		"html": false,
		"align": true,
		"reusable": true,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"color": {
			"text": true,
			"background": true,
			"gradient": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true,
			"fontFamily": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true
	},
	"attributes": {
		"iconSize": {
			"type": "string",
			"default": "24"
		},
		"iconSizeUnit": {
			"type": "string",
			"default": "px",
			"enum": ["px", "em", "rem", "%"]
		},
		"iconPosition": {
			"type": "string",
			"default": "left",
			"enum": ["left", "top", "right", "bottom"]
		},
		"iconSpacing": {
			"type": "string",
			"default": "8"
		},
		"iconAlign": {
			"type": "string",
			"default": "middle",
			"enum": ["top", "middle", "bottom"]
		},
		"iconColor": {
			"type": "string",
			"default": ""
		},
		"hoverOnly": {
			"type": "boolean",
			"default": false
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
